# Copy to .env and adjust. All vars are prefixed SCOUTEATS_.

# Optional Socrata app token (raises rate limits). Get one at
# https://data.cityofnewyork.us/profile/edit/developer_settings
# SCOUTEATS_SOCRATA_APP_TOKEN=your_token_here

# Dataset (DOHMH Restaurant Inspection Results). Override only if it changes.
SCOUTEATS_DATASET_DOHMH=43nn-pn8j

# Persistence. Default is local SQLite (no setup). For JSONB columns use Postgres:
# SCOUTEATS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/scouteats
SCOUTEATS_DATABASE_URL=sqlite+pysqlite:///./scouteats.db

# HTTP tuning
SCOUTEATS_REQUEST_TIMEOUT_SECONDS=30
SCOUTEATS_REQUEST_RETRIES=3
SCOUTEATS_BATCH_SIZE=1000
