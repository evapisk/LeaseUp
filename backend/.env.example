# Copy to .env and adjust. All vars are prefixed SCOUTEATS_.

# Optional Socrata app token (raises rate limits). Get one at
# https://data.cityofnewyork.us/profile/edit/developer_settings
# SCOUTEATS_SOCRATA_APP_TOKEN=your_token_here

# Dataset (DOHMH Restaurant Inspection Results). Override only if it changes.
SCOUTEATS_DATASET_DOHMH=43nn-pn8j

# Persistence. Default is local SQLite (no setup). For JSONB columns use Postgres:
# SCOUTEATS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/scouteats
SCOUTEATS_DATABASE_URL=sqlite+pysqlite:///./scouteats.db

# HTTP tuning
SCOUTEATS_REQUEST_TIMEOUT_SECONDS=30
SCOUTEATS_REQUEST_RETRIES=3
SCOUTEATS_BATCH_SIZE=1000

# Codify (codify.cafe = P2X Laravel api) AI enrichment for /analysis/enrich.
# If the token is absent or codify is unreachable, /analysis/enrich degrades
# gracefully to a deterministic local fallback plan and still returns 200.
# SCOUTEATS_CODIFY_ENABLED=true
# SCOUTEATS_CODIFY_BASE_URL=https://api.codify.inc
# SCOUTEATS_CODIFY_TOKEN=your_long_lived_sanctum_token_here
# SCOUTEATS_CODIFY_X_DOMAIN=codify.cafe          # tenant value, NOT the host
# SCOUTEATS_CODIFY_SUBPROJECT_ID=               # set to skip resolve-subproject
# SCOUTEATS_CODIFY_PIPE_NAME=restaurant_lease_takeover
# SCOUTEATS_CODIFY_TIMEOUT_SECONDS=20
# SCOUTEATS_CODIFY_PUBLIC_BASE_URL=https://codify.cafe
